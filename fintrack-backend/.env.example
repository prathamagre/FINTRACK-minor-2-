# Copy to .env for local development. Never commit real secrets.
FLASK_DEBUG=true
FINTRACK_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///fintrack.db
CORS_ORIGINS=http://localhost:3000
REDIS_URL=
# For production, configure REDIS_URL (or RATELIMIT_STORAGE_URI) to a private shared Redis-compatible service.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
